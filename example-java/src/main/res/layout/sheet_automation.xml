<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:tag="automate_sheet">

    <ImageView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:alpha="0.08"
        android:contentDescription="@null"
        android:src="@drawable/logo_provisioner" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/automate_provisioning"
            android:textColor="@color/brand_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/automate_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/package_name"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/package_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_result"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true"
            android:tag="package_name"
            android:textColor="@color/brand_black" />

        <TextView
            android:id="@+id/package_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/package_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/apk_url"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/apk_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_result"
            android:inputType="textUri"
            android:padding="12dp"
            android:singleLine="true"
            android:tag="apk_url"
            android:textColor="@color/brand_black" />

        <TextView
            android:id="@+id/url_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/apk_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/serial_no"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/serial_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_result"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true"
            android:tag="serial_number"
            android:textColor="@color/brand_black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/serial_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_accent"
            android:tag="save_automation"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/brand_white" />

        <Button
            android:id="@+id/btn_clear_automation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:tag="clear_automation"
            android:text="@string/turn_off_automation"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange"
            android:visibility="gone" />

        <TextView
            android:id="@+id/automation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_orange"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_clear_serial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:tag="clear_serial"
            android:text="@string/clear_serial_lock"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
