<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/automate_provisioning"
            android:textColor="@color/brand_black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/automate_help"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/package_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/package_name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:tag="package_name" />

        <TextView
            android:id="@+id/package_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/package_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/apk_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/apk_url"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:tag="apk_url" />

        <TextView
            android:id="@+id/apk_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apk_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/serial_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/serial_no"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:tag="serial_number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/serial_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/save_automation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_accent"
            android:tag="save_automation"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/brand_white" />

        <Button
            android:id="@+id/clear_automation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:tag="clear_automation"
            android:text="@string/turn_off_automation"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange"
            android:visibility="gone" />

        <TextView
            android:id="@+id/automation_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/brand_orange"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/clear_serial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:tag="clear_serial"
            android:text="@string/clear_serial_lock"
            android:textAllCaps="false"
            android:textColor="@color/brand_orange"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
